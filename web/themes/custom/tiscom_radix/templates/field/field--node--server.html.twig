{%
  set classes = [
  'field',
  'field--name-' ~ field_name|clean_class,
  'field--type-' ~ field_type|clean_class,
  'field--label-' ~ label_display,
]
%}

<div{{ attributes.addClass(classes) }}>
  {% if label_hidden %}
    {% for item in items %}
      <div{{ item.attributes.addClass('field__item') }}>
        {{ item.content
        |render
        |replace({
          'TisServer': 'TISSERVER'
        })
        |raw
        }}
      </div>
    {% endfor %}
  {% else %}
    <div{{ title_attributes.addClass('field__label') }}>
      {{ label }}
    </div>
    <div class="field__items">
      {% for item in items %}
        <div{{ item.attributes.addClass('field__item') }}>
          {{ item.content
          |render
          |replace({
            'TisServer': 'TISSERVER'
          })
          |raw
          }}
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>
