<?php

use Drupal\Core\Ajax\AjaxResponse;
use Drupal\Core\Ajax\ReplaceCommand;
use Drupal\Core\Form\FormStateInterface;

/**
 * Рекурсивно ищет элемент формы по ключу.
 *
 * Возвращает ссылку на найденный render array element.
 * Если элемент не найден, возвращает NULL.
 */
function &webform_ajax_element_find_element(array &$array, string $target_key) {
  foreach ($array as $key => &$value) {
    if ($key === $target_key) {
      return $value;
    }

    if (is_array($value)) {
      $found = &webform_ajax_element_find_element($value, $target_key);
      if ($found !== NULL) {
        return $found;
      }
    }
  }

  $null = NULL;
  return $null;
}

/**
 * Возвращает значение поля из form state.
 *
 * Сначала пытается взять обработанное значение через getValue(),
 * а если оно пустое — берет сырое значение из user input.
 */
function webform_ajax_element_get_submitted_value(FormStateInterface $form_state, string $key) {
  $value = $form_state->getValue($key);

  if (!empty($value) || $value === '0' || $value === 0) {
    return $value;
  }

  $user_input = $form_state->getUserInput();
  if (isset($user_input[$key])) {
    return $user_input[$key];
  }

  return NULL;
}

/**
 * Возвращает ключ элемента, который инициировал текущий submit/AJAX.
 */
function webform_ajax_element_get_trigger_key(FormStateInterface $form_state): ?string {
  $trigger = $form_state->getTriggeringElement();

  if (!$trigger || !is_array($trigger)) {
    return NULL;
  }

  if (!empty($trigger['#webform_key'])) {
    return $trigger['#webform_key'];
  }

  if (!empty($trigger['#name'])) {
    return $trigger['#name'];
  }

  return NULL;
}

/**
 * Оборачивает элемент в AJAX wrapper.
 */
function webform_ajax_element_add_wrapper(array &$element, string $wrapper_id): void {
  $element['#prefix'] = '<div id="' . $wrapper_id . '">';
  $element['#suffix'] = '</div>';
}

/**
 * Настраивает аргументы views selection handler для entity_select.
 */
function webform_ajax_element_set_view_arguments(array &$element, array $arguments, string $empty_option): void {
  $element['#selection_settings']['view']['arguments'] = $arguments;
  $element['#empty_option'] = $empty_option;
}

/**
 * Сбрасывает выбранное значение у зависимого select.
 */
function webform_ajax_element_reset_select(array &$element): void {
  $element['#default_value'] = NULL;
}

/**
 * Возвращает TRUE, если значение считается выбранным.
 */
function webform_ajax_element_has_value($value): bool {
  return !empty($value) || $value === '0' || $value === 0;
}

/**
 * Настраивает список поколений CPU по выбранному vendor.
 */
function webform_ajax_element_apply_cpu_generation_dependency(array &$cpu_generation_element, $vendor_value): void {
  if (webform_ajax_element_has_value($vendor_value)) {
    webform_ajax_element_set_view_arguments(
      $cpu_generation_element,
      [$vendor_value],
      '- Выберите поколение процессора -'
    );
  }
  else {
    webform_ajax_element_set_view_arguments(
      $cpu_generation_element,
      [-1],
      '- Сначала выберите производителя -'
    );
  }
}

/**
 * Настраивает список платформ по поколению CPU и форм-фактору.
 *
 * ВАЖНО:
 * Порядок аргументов должен совпадать с порядком контекстных фильтров во view:
 * 1. Cpu Generation
 * 2. Форм-фактор / высота в юнитах
 */
function webform_ajax_element_apply_platform_dependency(array &$platform_element, $cpu_generation_value, $form_factor_units_value): void {
  if (webform_ajax_element_has_value($cpu_generation_value) && webform_ajax_element_has_value($form_factor_units_value)) {
    webform_ajax_element_set_view_arguments(
      $platform_element,
      [$cpu_generation_value, $form_factor_units_value],
      '- Выберите платформу -'
    );
  }
  elseif (webform_ajax_element_has_value($cpu_generation_value)) {
    webform_ajax_element_set_view_arguments(
      $platform_element,
      [-1, -1],
      '- Сначала выберите форм-фактор -'
    );
  }
  else {
    webform_ajax_element_set_view_arguments(
      $platform_element,
      [-1, -1],
      '- Сначала выберите поколение процессора -'
    );
  }
}

/**
 * AJAX callback: после смены vendor обновляет и поколения CPU, и платформы.
 */
function webform_ajax_element_cpu_vendor_ajax_callback(array &$form, FormStateInterface $form_state) {
  $response = new AjaxResponse();

  $cpu_generation_element = &webform_ajax_element_find_element($form, 'cpu_generation_entity_selection');
  $platform_element = &webform_ajax_element_find_element($form, 'platform_entity_selection');

  if ($cpu_generation_element !== NULL) {
    $response->addCommand(new ReplaceCommand('#cpu-generation-wrapper', $cpu_generation_element));
  }

  if ($platform_element !== NULL) {
    $response->addCommand(new ReplaceCommand('#platform-wrapper', $platform_element));
  }

  return $response;
}

/**
 * AJAX callback: после смены поколения CPU обновляет платформы.
 */
function webform_ajax_element_cpu_generation_ajax_callback(array &$form, FormStateInterface $form_state) {
  $platform_element = &webform_ajax_element_find_element($form, 'platform_entity_selection');

  if ($platform_element !== NULL) {
    return $platform_element;
  }

  return $form;
}

/**
 * AJAX callback: после смены форм-фактора обновляет платформы.
 */
function webform_ajax_element_vysota_ajax_callback(array &$form, FormStateInterface $form_state) {
  $platform_element = &webform_ajax_element_find_element($form, 'platform_entity_selection');

  if ($platform_element !== NULL) {
    return $platform_element;
  }

  return $form;
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function webform_ajax_element_form_webform_submission_main_server_configurator_node_7905_add_form_alter(
  array &$form,
  FormStateInterface $form_state,
  $form_id
) {
  $cpu_vendor_element = &webform_ajax_element_find_element($form, 'cpu_vendor');
  $cpu_generation_element = &webform_ajax_element_find_element($form, 'cpu_generation_entity_selection');
  $platform_element = &webform_ajax_element_find_element($form, 'platform_entity_selection');
  $vysota_element = &webform_ajax_element_find_element($form, 'form_factor_units');

  if (
    $cpu_vendor_element === NULL ||
    $cpu_generation_element === NULL ||
    $platform_element === NULL ||
    $vysota_element === NULL
  ) {
    return;
  }

  // Добавляем wrapper'ы для AJAX replacement.
  webform_ajax_element_add_wrapper($cpu_generation_element, 'cpu-generation-wrapper');
  webform_ajax_element_add_wrapper($platform_element, 'platform-wrapper');

  // 1) cpu_vendor -> cpu_generation_entity_selection (+ сброс platform).
  $cpu_vendor_element['#ajax'] = [
    'callback' => 'webform_ajax_element_cpu_vendor_ajax_callback',
    'wrapper' => 'cpu-generation-wrapper',
    'event' => 'change',
    'progress' => [
      'type' => 'throbber',
      'message' => t('Загружаем поколения процессоров...'),
    ],
  ];

  // 2) cpu_generation_entity_selection -> platform_entity_selection.
  $cpu_generation_element['#ajax'] = [
    'callback' => 'webform_ajax_element_cpu_generation_ajax_callback',
    'wrapper' => 'platform-wrapper',
    'event' => 'change',
    'progress' => [
      'type' => 'throbber',
      'message' => t('Загружаем совместимые платформы...'),
    ],
  ];

  // 3) 	form_factor_units -> platform_entity_selection.
  $vysota_element['#ajax'] = [
    'callback' => 'webform_ajax_element_vysota_ajax_callback',
    'wrapper' => 'platform-wrapper',
    'event' => 'change',
    'progress' => [
      'type' => 'throbber',
      'message' => t('Загружаем совместимые платформы...'),
    ],
  ];

  $trigger_key = webform_ajax_element_get_trigger_key($form_state);

  $vendor_value = webform_ajax_element_get_submitted_value($form_state, 'cpu_vendor');
  $cpu_generation_value = webform_ajax_element_get_submitted_value($form_state, 'cpu_generation_entity_selection');
  $form_factor_units_value = webform_ajax_element_get_submitted_value($form_state, 'form_factor_units');

  // Настраиваем список поколений CPU по vendor.
  webform_ajax_element_apply_cpu_generation_dependency($cpu_generation_element, $vendor_value);

  // Если изменился vendor, сбрасываем поколение CPU.
  if ($trigger_key === 'cpu_vendor') {
    webform_ajax_element_reset_select($cpu_generation_element);
    $cpu_generation_value = NULL;
  }

  // Если изменилось поколение CPU, сбрасываем платформу.
  if ($trigger_key === 'cpu_generation_entity_selection') {
    webform_ajax_element_reset_select($platform_element);
  }

  // Если изменился форм-фактор, сбрасываем платформу.
  if ($trigger_key === 'form_factor_units') {
    webform_ajax_element_reset_select($platform_element);
  }

  // Если изменился vendor, платформу тоже обязательно сбрасываем.
  if ($trigger_key === 'cpu_vendor') {
    webform_ajax_element_reset_select($platform_element);
  }

  // Настраиваем список платформ по поколению CPU + форм-фактору.
  webform_ajax_element_apply_platform_dependency(
    $platform_element,
    $cpu_generation_value,
    $form_factor_units_value
  );

  \Drupal::logger('webform_ajax_element')->debug(
    'cpu_generation_value: <pre>@data</pre>',
    ['@data' => print_r($cpu_generation_value, TRUE)]
  );

  \Drupal::logger('webform_ajax_element')->debug(
    'form_factor_units_value: <pre>@data</pre>',
    ['@data' => print_r($form_factor_units_value, TRUE)]
  );

  \Drupal::logger('webform_ajax_element')->debug(
    'ALL input: <pre>@data</pre>',
    ['@data' => print_r($form_state->getUserInput(), TRUE)]
  );

  $form_state->setRebuild(TRUE);
}
