        "drupal/views_migration": "^1.2",
        "drupal/views_rss": "^2.3",
        "drupal/views_selective_filters": "^2.0@alpha",
        "drupal/views_slideshow": "5.0",
        "drupal/views_url_alias": "^3.1",
        "drupal/viewsreference": "^2.0@beta",
        "drupal/webform": "^6.2",
        "drupal/webform_content_creator": "4.0",
        "drupal/webform_entity_view": "^1.0",
        "drupal/webform_hierarchy": "^1.2",
        "drupal/webform_migrate": "^2.0@alpha",
        "drupal/webform_views": "^5.5",
        "drupal/xmlsitemap": "^1.5",
        "drupal/yandex_maps": "^2.0",
        "drupal/yoast_seo": "^2.2",
        "drush/drush": "^13.3",
        "spatie/pdf-to-image": "^3.1"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true,
            "cweagans/composer-patches": true
        },
        "sort-packages": true
    },
    "extra": {
        "patches": {
            "drupal/webform": {
                "#webform-ajax_refresh_view_selection": "https://www.drupal.org/files/issues/2022-09-12/webform-ajax_refresh_view_selection.patch"
            },
            "drupal/layout_builder": {
                "#form-ajaxSubmit-in-not-a-fuction-3335356": "https://www.drupal.org/files/issues/2023-01-25/issue_3335356_drupal10.patch",
    "#form-ajaxSubmit-in-not-a-fuction-3330458": "https://www.drupal.org/files/issues/2023-03-07/bootstrap_styles-3330458-8.patch",
    "#form-ajaxSubmit-in-not-a-fuction-3315218-17": "https://www.drupal.org/files/issues/2023-01-25/3315218-17--1-0-x.patch"
            },
            "drupal/pathauto": {
                "#3189713-2--declare-upgrade-status": "https://www.drupal.org/files/issues/2020-12-23/3189713-2--declare-upgrade-status.patch",
                "#n3079275-75-combined": "https://www.drupal.org/files/issues/2024-07-29/pathauto-n3079275-75-combined.patch",
                "#3275041": "https://www.drupal.org/files/issues/2022-04-13/add_bypass_uniquifier_settings-3275041-2.patch"
                  },
            "drupal/views_migration": {
                "#3451074 Deprecated function $typeMap": "https://www.drupal.org/files/issues/2024-05-30/3451074.patch"
            },
            "drupal/core": {
                "#core-derive_menu_link_migrations_per_entity_type-3051251-69  menu links show validation issues on migration": "https://www.drupal.org/files/issues/2023-03-16/core-derive_menu_link_migrations_per_entity_type-3051251-69.patch"
            }
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/installing-drupal",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        }
    },
    "require-dev": {
        "symfony/var-dumper": "^6.4"
    }
}
